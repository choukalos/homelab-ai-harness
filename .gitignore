# Never commit private content
tmp/
media/
outputs/
logs/  # Skill runner logs — auto-rotating, 10MB max
*.png
*.jpg
*.jpeg
*.webp
*.mp4
.env

# Environment file variants
.env.local
.env.production
.env.staging
.env.backup
.env.bak
.env.*.local
.env.*.production

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
id_ecdsa

# Secrets, tokens, and credentials
*.secret
*.token
*.credentials
credentials.json

# MySQL config with credentials
mysql-exporter/.my.cnf

