import hashlib
import json
import os
from typing import Any, Literal

import httpx
import redis
from fastapi import FastAPI, Header, HTTPException
from pydantic import BaseModel, Field


app = FastAPI(title="AI Harness", version="0.1.0")

HARNESS_API_KEY = os.getenv("HARNESS_API_KEY", "")
SEARXNG_BASE_URL = os.getenv("SEARXNG_BASE_URL", "http://searxng:8080")
CRAWL4AI_BASE_URL = os.getenv("CRAWL4AI_BASE_URL", "http://crawl4ai:11235")
LITELLM_BASE_URL = os.getenv("LITELLM_BASE_URL", "http://litellm:4000")
LITELLM_API_KEY = os.getenv("LITELLM_API_KEY", "")
HARNESS_MODEL = os.getenv("HARNESS_MODEL", "local/gemma-4-26b")
REDIS_URL = os.getenv("REDIS_URL", "redis://redis:6379/0")

cache = redis.from_url(REDIS_URL, decode_responses=True)






class WebSearchRequest(BaseModel):
    query: str
    max_results: int = Field(default=5, ge=1, le=10)
    crawl_results: int = Field(default=3, ge=0, le=5)
    category: str = "general"
    language: str = "en"
    time_range: Literal["day", "month", "year"] | None = None
    summarize: bool = True
    mode: Literal["quick", "sources", "answer"] = "answer"


class SearchResult(BaseModel):
    title: str | None = None
    url: str
    content: str | None = None
    engine: str | None = None
    score: float | None = None
    extracted_markdown: str | None = None


def require_api_key(x_api_key: str | None) -> None:
    if HARNESS_API_KEY and x_api_key != HARNESS_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid API key")


def cache_key(prefix: str, payload: dict[str, Any]) -> str:
    raw = json.dumps(payload, sort_keys=True)
    return f"{prefix}:{hashlib.sha256(raw.encode()).hexdigest()}"


@app.get("/health")
async def health() -> dict[str, str]:
    return {"status": "ok"}


@app.post("/tools/web-search")
async def web_search(
    req: WebSearchRequest,
    x_api_key: str | None = Header(default=None),
) -> dict[str, Any]:
    require_api_key(x_api_key)

    key = cache_key("web-search", req.model_dump())
    cached = cache.get(key)
    if cached:
        return json.loads(cached)

    async with httpx.AsyncClient(timeout=45.0) as client:
        results = await search_searxng(client, req)

        crawled: list[SearchResult] = []
        for item in results[: req.crawl_results]:
            crawled.append(await crawl_url(client, item))

        merged = crawled + results[req.crawl_results :]
	if req.mode == "sources":
    		answer = None
	elif req.summarize:
    		answer = await synthesize_answer(client, req.query, merged)
	else:
    		answer = None

    response = {
        "query": req.query,
        "answer": answer,
        "results": [r.model_dump() for r in merged[: req.max_results]],
    }

    cache.setex(key, 60 * 30, json.dumps(response))
    return response

class ResearchBriefRequest(BaseModel):
    topic: str
    max_queries: int = Field(default=4, ge=1, le=8)
    results_per_query: int = Field(default=5, ge=1, le=10)


@app.post("/tools/research-brief")
async def research_brief(
    req: ResearchBriefRequest,
    x_api_key: str | None = Header(default=None),
) -> dict[str, Any]:
    require_api_key(x_api_key)

    async with httpx.AsyncClient(timeout=90.0) as client:
        queries = await generate_research_queries(client, req.topic, req.max_queries)

        all_results = []
        for q in queries:
            search_req = WebSearchRequest(
                query=q,
                max_results=req.results_per_query,
                crawl_results=2,
                summarize=False,
                mode="sources",
            )
            results = await search_searxng(client, search_req)
            all_results.extend(results)

        unique = dedupe_results(all_results)
        brief = await synthesize_research_brief(client, req.topic, unique)

    return {
        "topic": req.topic,
        "queries": queries,
        "brief": brief,
        "sources": [r.model_dump() for r in unique[:20]],
    }

def dedupe_results(results: list[SearchResult]) -> list[SearchResult]:
    seen = set()
    unique = []

    for r in results:
        if r.url in seen:
            continue
        seen.add(r.url)
        unique.append(r)

    return unique


async def generate_research_queries(
    client: httpx.AsyncClient,
    topic: str,
    max_queries: int,
) -> list[str]:
    prompt = f"""
Generate {max_queries} focused web search queries for this research topic.

Topic:
{topic}

Return only JSON:
["query 1", "query 2"]
""".strip()

    r = await client.post(
        f"{LITELLM_BASE_URL}/chat/completions",
        headers={"Authorization": f"Bearer {LITELLM_API_KEY}"},
        json={
            "model": HARNESS_MODEL,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.2,
        },
    )
    r.raise_for_status()

    text = r.json()["choices"][0]["message"]["content"]

    try:
        return json.loads(text)[:max_queries]
    except Exception:
        return [topic]


async def synthesize_research_brief(
    client: httpx.AsyncClient,
    topic: str,
    results: list[SearchResult],
) -> str:
    source_text = "\n\n".join(
        f"[{i + 1}] {r.title}\nURL: {r.url}\nSnippet: {r.content}"
        for i, r in enumerate(results[:20])
    )

    prompt = f"""
Create a concise research brief using only these sources.

Topic:
{topic}

Include:
- Executive summary
- Key findings
- Risks / uncertainty
- Recommended next steps
- Source citations like [1], [2]

Sources:
{source_text}
""".strip()

    r = await client.post(
        f"{LITELLM_BASE_URL}/chat/completions",
        headers={"Authorization": f"Bearer {LITELLM_API_KEY}"},
        json={
            "model": HARNESS_MODEL,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.2,
        },
    )
    r.raise_for_status()

    return r.json()["choices"][0]["message"]["content"]

async def search_searxng(
    client: httpx.AsyncClient,
    req: WebSearchRequest,
) -> list[SearchResult]:
    params = {
        "q": req.query,
        "format": "json",
        "categories": req.category,
        "language": req.language,
        "pageno": 1,
        "safesearch": 1,
    }

    if req.time_range:
        params["time_range"] = req.time_range

    r = await client.get(f"{SEARXNG_BASE_URL}/search", params=params)
    r.raise_for_status()

    data = r.json()
    output: list[SearchResult] = []

    for item in data.get("results", [])[: req.max_results]:
        url = item.get("url")
        if not url:
            continue

        output.append(
            SearchResult(
                title=item.get("title"),
                url=url,
                content=item.get("content"),
                engine=item.get("engine"),
                score=item.get("score"),
            )
        )

    return output


async def crawl_url(
    client: httpx.AsyncClient,
    item: SearchResult,
) -> SearchResult:
    try:
        r = await client.post(
            f"{CRAWL4AI_BASE_URL}/crawl",
            json={
                "urls": [item.url],
                "crawler_config": {
                    "type": "CrawlerRunConfig",
                    "params": {
                        "word_count_threshold": 80,
                        "excluded_tags": ["nav", "footer", "aside"],
                    },
                },
            },
        )
        r.raise_for_status()
        data = r.json()

        extracted = json.dumps(data)[:12000]

        item.extracted_markdown = extracted
        return item

    except Exception as e:
        item.extracted_markdown = f"Crawl failed: {e}"
        return item


async def synthesize_answer(
    client: httpx.AsyncClient,
    query: str,
    results: list[SearchResult],
) -> str:
    source_text = "\n\n".join(
        f"[{i + 1}] {r.title}\nURL: {r.url}\nSnippet: {r.content}\nExtracted: {r.extracted_markdown}"
        for i, r in enumerate(results)
    )

    prompt = f"""
Answer the user's question using only the sources below.

Rules:
- Be concise.
- Cite sources inline as [1], [2], etc.
- If sources are weak or conflicting, say so.
- Do not invent facts.

Question:
{query}

Sources:
{source_text}
""".strip()

    r = await client.post(
        f"{LITELLM_BASE_URL}/chat/completions",
        headers={"Authorization": f"Bearer {LITELLM_API_KEY}"},
        json={
            "model": HARNESS_MODEL,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.2,
        },
        timeout=90.0,
    )
    r.raise_for_status()
    return r.json()["choices"][0]["message"]["content"]


