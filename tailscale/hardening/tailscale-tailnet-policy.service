[Unit]
Description=Tailscale tailnet ingress policy (nftables allowlist on thor)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table inet tailnet_policy
ExecStart=/usr/sbin/nft -f /etc/tailscale/thor-tailnet.nft
ExecStop=/usr/sbin/nft delete table inet tailnet_policy

[Install]
WantedBy=multi-user.target