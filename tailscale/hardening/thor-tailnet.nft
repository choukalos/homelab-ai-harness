# thor-tailnet.nft — tailnet ingress policy for thor (subnet router).
#
# Tailscale ROUTES (no NAT): traffic arriving from the tailnet carries
# source 100.64.0.0/10 (v4) or 2600:1c00::/8 (v6). LAN traffic keeps its
# 192.168.x.x source. This policy allowlists tailnet traffic and drops
# everything else from the tailnet — LAN traffic is never matched, so
# at-home usage (incl. ssh with passwords) is completely unchanged.
#
# Load:    sudo nft -f thor-tailnet.nft
# Unload:  sudo nft delete table inet tailnet_policy
#
# Note: only tailnet-sourced traffic is affected; Docker/LAN traffic
# (container ports, LAN clients) passes through untouched.

table inet tailnet_policy {
    chain input {
        type filter hook input priority filter; policy accept;

        ct state established,related accept
        iifname "lo" accept

        # --- tailnet -> thor itself: SSH only ---
        ip  saddr 100.64.0.0/10 tcp dport 22 accept
        ip6 saddr 2600:1c00::/8 tcp dport 22 accept

        # Add more as needed, e.g.:
        # ip saddr 100.64.0.0/10 tcp dport { 443 } accept   # local web

        ip  saddr 100.64.0.0/10 drop
        ip6 saddr 2600:1c00::/8 drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ct state established,related accept

        # --- tailnet -> LAN (routed) ---
        # SSH to matrix
        ip saddr 100.64.0.0/10 ip daddr 192.168.4.55 tcp dport 22 accept
        # SMB to the NASes
        ip saddr 100.64.0.0/10 ip daddr 192.168.5.0/24 tcp dport { 139, 445 } accept
        # Synology DSM web (adjust IP/ports to your NAS)
        ip saddr 100.64.0.0/10 ip daddr 192.168.5.0/24 tcp dport { 5000, 5001 } accept
        # IPv6 to the LAN (SLAAC prefix as seen on thor; adjust if yours differs)
        ip6 saddr 2600:1c00::/8 ip6 daddr fdc0:ae56:ce7f:49b5::/64 \
            tcp dport { 22, 139, 445, 5000, 5001 } accept

        # Everything else from the tailnet to the LAN: drop
        ip  saddr 100.64.0.0/10 drop
        ip6 saddr 2600:1c00::/8 drop
    }
}