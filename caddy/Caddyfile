{
	auto_https off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	@www host www.choukalos.com
	redir @www https://choukalos.com{uri} permanent

	@blog host choukalos.com
	handle @blog {
		# Same-origin media access (blog-todo.md B3) — mirrors the siri route so
		# blog posts can embed generated artifacts (charts/demos/videos) on
		# choukalos.com.
		# SEC-12 interim (2026-11-26, finding 12.4): siri_outputs = personal Q&A
		# with enumerable names — not for public serving. 404 until the P12-A
		# file-bridge cutover replaces this route with the allowlist policy.
		# Rollback: delete this block.
		handle /media/files/siri_outputs/* {
			respond "Not Found" 404
		}
		handle /media/files/* {
			reverse_proxy http://skill-runner:8091
		}
		# Hugo portal (blog-todo.md B4 cutover, 2026-08-28): static site +
		# /files/ public drop zone + /status/. Served by the portal container
		# (compose/compose.portal.yml: git-sync + portal).
		reverse_proxy http://portal:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@invest host invest.choukalos.com
	handle @invest {
		# 1. Route API requests to the backend server (same-origin, no CORS)
		route /api/* {
			reverse_proxy http://invest-hub-server:4000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# 2. Route everything else to the frontend React client container
		reverse_proxy http://invest-hub-client:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@api host api.choukalos.com
	handle @api {
		reverse_proxy http://invest-hub-server:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@siri_media {
		host siri.choukalos.com
		path /media/files/*
	}
	handle @siri_media {
		# SEC-12 interim (2026-11-26, finding 12.4): siri_outputs is siri-only
		# (D13) — 404 publicly until the P12-A file-bridge allowlist lands. Siri
		# keeps its own access path (skill API artifact endpoint + LAN). Rollback:
		# delete this block.
		handle /media/files/siri_outputs/* {
			respond "Not Found" 404
		}
		reverse_proxy http://skill-runner:8091
	}

	# Media pipeline public route (2026-09-07, media_pipeline_gaps.md T3;
	# option C — served under siri.choukalos.com, no new CF DNS record):
	#   /media/pipeline/dl/<token>  signed-token file download — PUBLIC.
	#                               The token IS the credential (minted
	#                               LAN-only by the pipeline's /dl_token;
	#                               TTL 1–168h). Range requests supported.
	#   /media/pipeline/upload      local-file upload — authenticated
	#                               (X-Api-Key = chuck/dylan LiteLLM key).
	# Everything else under /media/pipeline/* -> 404: the rest of the
	# pipeline API (jobs, /files/*, /dl_token, ...) stays LAN-only.
	@siri_pipeline {
		host siri.choukalos.com
		path /media/pipeline/*
	}
	handle @siri_pipeline {
		uri strip_prefix /media/pipeline
		# Signed-token download (public; token is the credential).
		handle /dl/* {
			reverse_proxy http://192.168.4.55:8189
		}
		# Upload (authenticated, multipart, 500MB cap enforced by matrix).
		handle /upload {
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://192.168.4.55:8189
		}
		respond "Not Found" 404
	}

	# Presenton is LAN-only (family use, passwordless): http://thor.local:5000
	# (compose/compose.ai-core.yml, DISABLE_AUTH=true). No public route on purpose.

	@siri host siri.choukalos.com
	handle @siri {
		# Health check
		handle /health {
			reverse_proxy http://skill-runner:8091
		}

		# Siri API — authenticated proxy to skill-runner
		handle /siri/* {
			uri strip_prefix /siri
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://skill-runner:8091
		}

		# Chat Gateway API — authenticated proxy to skill-runner
		handle /api/* {
			uri strip_prefix /api
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://skill-runner:8091
		}

		respond "Not Found" 404
	}

	@llm host llm.choukalos.com
	handle @llm {
		# Key gate (security_todo Phase 1, 2026-11-15): only Chuck's or Dylan's
		# LiteLLM key (X-Api-Key header, or Authorization: Bearer <key> for
		# OpenAI-SDK clients). Everything else 401 — even if LiteLLM auth is
		# misconfigured, the public route only carries the two family keys.
		# Same expression shape as the siri gate (De Morgan of OR-of-keys),
		# extended with the Bearer form. Key rotation: update .env AND reload
		# caddy, or the public route breaks (see security_todo Phase 7).
		@llmNoAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}' && {http.request.header.Authorization} != "Bearer {$LITELLM_KEY_CHUCK}" && {http.request.header.Authorization} != "Bearer {$LITELLM_KEY_DYLAN}"
		respond @llmNoAuth "Unauthorized" 401
		reverse_proxy http://litellm-proxy:4000 {
		  # Force Caddy to stream large MCP tool payloads immediately
		  flush_interval -1
		  header_up Host {host}
		  header_up X-Real-IP {remote_host}
		  header_up X-Forwarded-Proto https
		  header_up X-Forwarded-Port 443
		}
	}

	@plausible host plausible.choukalos.com
	handle @plausible {
		# Allow analytics script loading
		handle /js/* {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Allow event tracking
		handle /api/event {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Block everything else (admin UI, login, register) from internet
		respond "404 Not Found" 404
	}

	# test.choukalos.com — reserved for public-facing test properties.
	# Was the tipcalc Skills E2E smoke test (2026-11-23); TORN DOWN 2026-11-24
	# (app, compose, data + GitHub repo removed; kanban project id 11 kept as the
	# durable record of the smoke test). Handler + CF tunnel/DNS are kept on
	# purpose so the URL stays warm for reuse — it currently 502s (no backend).
	# To reuse: bring up a service on tipcalc:8080, or re-point this block at the
	# new backend.
	@tipcalc host test.choukalos.com
	handle @tipcalc {
		reverse_proxy http://tipcalc:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	respond "Not Found" 404
}
