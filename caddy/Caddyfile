{
	auto_https off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	@www host www.choukalos.com
	redir @www https://choukalos.com{uri} permanent

	@ghost host choukalos.com
	handle @ghost {
		reverse_proxy http://ghost-blog:2368 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

    @invest host invest.choukalos.com
    handle @invest {
		# 1. Route API requests to the backend server (same-origin, no CORS)
		route /api/* {
			reverse_proxy http://invest-hub-server:4000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# 2. Route everything else to the frontend React client container
		reverse_proxy http://invest-hub-client:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@api host api.choukalos.com
	handle @api {
		reverse_proxy http://invest-hub-server:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}


#	@invest host invest.choukalos.com
