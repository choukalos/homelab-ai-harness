{
	auto_https off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	@www host www.choukalos.com
	redir @www https://choukalos.com{uri} permanent

	@ghost host choukalos.com
	handle @ghost {
		reverse_proxy http://ghost-blog:2368 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

    @invest host invest.choukalos.com
    handle @invest {
		# 1. Route API requests to the backend server (same-origin, no CORS)
		route /api/* {
			reverse_proxy http://invest-hub-server:4000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# 2. Route everything else to the frontend React client container
		reverse_proxy http://invest-hub-client:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@api host api.choukalos.com
	handle @api {
		reverse_proxy http://invest-hub-server:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}


#	@invest host invest.choukalos.com
#	handle @invest {
#	          reverse_proxy http://invest-hub-client:80 {
#              header_up Host {host}
#              header_up X-Real-IP {remote_host}
#              header_up X-Forwarded-For {remote_host}
#              header_up X-Forwarded-Host {host} 
#              header_up X-Forwarded-Proto https
#              header_up X-Forwarded-Port 443
#            }
#	}

	@siri_media host siri.choukalos.com path /media/files/*
	handle @siri_media {
		# Old: reverse_proxy http://ai-harness:8090
		reverse_proxy http://skill-runner:8091
	}

	@siri host siri.choukalos.com
	handle @siri {
		# Optional health check
		handle /health {
			# Old: reverse_proxy http://ai-harness:8090
			reverse_proxy http://skill-runner:8091
		}

		# Siri API requires auth
		handle /siri/* {
			@noAuth not header X-API-Key {$SIRI_API_KEY}
			respond @noAuth "Unauthorized" 401

			# Old: reverse_proxy http://ai-harness:8090
			reverse_proxy http://skill-runner:8091
		}

		respond "Not Found" 404
	}


	@llm host llm.choukalos.com
	handle @llm {
		@noAuth not header X-API-Key {$LITELLM_PUBLIC_API_KEY}
		respond @noAuth "Unauthorized" 401

		reverse_proxy http://litellm-proxy:4000
	}

	@plausible host plausible.choukalos.com
	handle @plausible {
		# Allow analytics script loading
		handle /js/* {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Allow event tracking
		handle /api/event {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Block everything else (admin UI, login, register) from internet
		respond "404 Not Found" 404
	}

	respond "Not Found" 404
}

