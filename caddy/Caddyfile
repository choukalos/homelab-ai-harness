{
	auto_https off
}

:80 {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	@www host www.choukalos.com
	redir @www https://choukalos.com{uri} permanent

	@blog host choukalos.com
	handle @blog {
		# Same-origin media access (blog-todo.md B3) — mirrors the siri route so
		# blog posts can embed generated artifacts (charts/demos/videos) on
		# choukalos.com.
		handle /media/files/* {
			reverse_proxy http://skill-runner:8091
		}
		# Hugo portal (blog-todo.md B4 cutover, 2026-08-28): static site +
		# /files/ public drop zone + /status/. Served by the portal container
		# (compose/compose.portal.yml: git-sync + portal).
		reverse_proxy http://portal:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@invest host invest.choukalos.com
	handle @invest {
		# 1. Route API requests to the backend server (same-origin, no CORS)
		route /api/* {
			reverse_proxy http://invest-hub-server:4000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# 2. Route everything else to the frontend React client container
		reverse_proxy http://invest-hub-client:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@api host api.choukalos.com
	handle @api {
		reverse_proxy http://invest-hub-server:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	@siri_media {
		host siri.choukalos.com
		path /media/files/*
	}
	handle @siri_media {
		reverse_proxy http://skill-runner:8091
	}

	# Media pipeline public route (2026-09-07, media_pipeline_gaps.md T3;
	# option C — served under siri.choukalos.com, no new CF DNS record):
	#   /media/pipeline/dl/<token>  signed-token file download — PUBLIC.
	#                               The token IS the credential (minted
	#                               LAN-only by the pipeline's /dl_token;
	#                               TTL 1–168h). Range requests supported.
	#   /media/pipeline/upload      local-file upload — authenticated
	#                               (X-Api-Key = chuck/dylan LiteLLM key).
	# Everything else under /media/pipeline/* -> 404: the rest of the
	# pipeline API (jobs, /files/*, /dl_token, ...) stays LAN-only.
	@siri_pipeline {
		host siri.choukalos.com
		path /media/pipeline/*
	}
	handle @siri_pipeline {
		uri strip_prefix /media/pipeline
		# Signed-token download (public; token is the credential).
		handle /dl/* {
			reverse_proxy http://192.168.4.55:8189
		}
		# Upload (authenticated, multipart, 500MB cap enforced by matrix).
		handle /upload {
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://192.168.4.55:8189
		}
		respond "Not Found" 404
	}

	# Presenton is LAN-only (family use, passwordless): http://thor.local:5000
	# (compose/compose.ai-core.yml, DISABLE_AUTH=true). No public route on purpose.

	@siri host siri.choukalos.com
	handle @siri {
		# Health check
		handle /health {
			reverse_proxy http://skill-runner:8091
		}

		# Siri API — authenticated proxy to skill-runner
		handle /siri/* {
			uri strip_prefix /siri
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://skill-runner:8091
		}

		# Chat Gateway API — authenticated proxy to skill-runner
		handle /api/* {
			uri strip_prefix /api
			@noAuth expression {http.request.header.X-Api-Key} != '{$LITELLM_KEY_CHUCK}' && {http.request.header.X-Api-Key} != '{$LITELLM_KEY_DYLAN}'
			respond @noAuth "Unauthorized" 401
			reverse_proxy http://skill-runner:8091
		}

		respond "Not Found" 404
	}

	@llm host llm.choukalos.com
	handle @llm {
		reverse_proxy http://litellm-proxy:4000
	}

	@plausible host plausible.choukalos.com
	handle @plausible {
		# Allow analytics script loading
		handle /js/* {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Allow event tracking
		handle /api/event {
			reverse_proxy http://plausible:8000 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Port 443
			}
		}

		# Block everything else (admin UI, login, register) from internet
		respond "404 Not Found" 404
	}

	respond "Not Found" 404
}
