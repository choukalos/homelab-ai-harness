#!/usr/bin/env bash
# Pre-commit hook: (1) validate skills YAML, (2) block secret material.
#
# (1) Guards against the 2026-09-01 pi.dev bug: an unquoted `: ` inside a
#     SKILL.md frontmatter `description` value is invalid YAML and breaks
#     clients that parse the frontmatter.
#
# (2) Blocks commits that stage secret material (2026-09-04 credential
#     rotation: a leaked zip contained the live .env). Checks:
#       - staged file NAMES that are secret files (.env, *.pem, *.key, ...)
#       - staged ADDED LINES matching known token formats (AWS, OpenAI/LiteLLM
#         sk-, GitHub, Slack, private key blocks, base64 Basic-auth blobs)
#       - high-entropy literals assigned to secret-looking variable names
#     Env references (${VAR}) and obvious placeholders are allowed.
#
# Bypass (only if you are SURE): git commit --no-verify
# Activated via: git config core.hooksPath .githooks  (once per clone)

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# 1) Skills YAML validation (only when skill files are staged)
# ---------------------------------------------------------------------------
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(agents-skills/|skills/|tests/test_skills_yaml\.py)'; then
    if ! python3 tests/test_skills_yaml.py; then
        echo ""
        echo "pre-commit: skills YAML validation FAILED — fix the errors above."
        echo "  - SKILL.md frontmatter must be strict-parseable YAML (quote or reword values containing ': ')"
        echo "  - SKILL.md description must match skills/<name>/skill.yml"
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# 2) Secrets check
# ---------------------------------------------------------------------------
if ! python3 - <<'PYEOF'
import math
import re
import subprocess
import sys

# --- staged file names that must never be committed -------------------------
SECRET_NAME = re.compile(
    r'(^|/)(\.env(\..+)?|.*\.pem$|.*\.key$|id_rsa.*|.*\.p12$|.*\.pfx$|.*\.jks$'
    r'|.*\.keystore$|keystore.*|credentials\.json$|secrets?\.[a-z0-9]+$|.*\.secret$)'
    r'$',
    re.I,
)
# .env.example / .env.sample / .env.template are fine
ALLOWED_NAME = re.compile(r'\.env\.(example|sample|template)$', re.I)

def mask(s):
    s = s.strip()
    return (s[:4] + f'…({len(s)} chars)') if len(s) > 8 else f'…({len(s)} chars)'

def shannon(s):
    if not s:
        return 0.0
    n = len(s)
    freq = {}
    for c in s:
        freq[c] = freq.get(c, 0) + 1
    return -sum((cnt / n) * math.log2(cnt / n) for cnt in freq.values())

# --- known token formats (searched in added lines) ---------------------------
PATTERNS = [
    (re.compile(r'AKIA[0-9A-Z]{16}'), 'AWS access key ID'),
    (re.compile(r'sk-[A-Za-z0-9_-]{20,}'), 'OpenAI/LiteLLM-style API key (sk-…)'),
    (re.compile(r'gh[pousr]_[A-Za-z0-9]{36,}'), 'GitHub token'),
    (re.compile(r'github_pat_[A-Za-z0-9_]{20,}'), 'GitHub fine-grained PAT'),
    (re.compile(r'xox[baprs]-[A-Za-z0-9-]{10,}'), 'Slack token'),
    (re.compile(r'-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY'), 'private key block'),
    (re.compile(r'Basic [A-Za-z0-9+/]{24,}={0,2}'), 'base64 Basic-auth blob'),
]

# KEY=literal / KEY: literal where KEY looks secret-ish
GENERIC = re.compile(
    r'''(?ix)
    \b([A-Z0-9_.-]*(?:PASSWORD|PASSWD|SECRET|API[_-]?KEY|ACCESS[_-]?KEY|
    TOKEN|CREDENTIAL|MASTER[_-]?KEY|SIGNING[_-]?KEY)[A-Z0-9_.-]*)
    \s*[:=]\s*
    ['"]?([A-Za-z0-9+/=_\-]{16,})'''
)
PLACEHOLDER = re.compile(
    r'^(changeme\w*|example\w*|placeholder\w*|your[_-]\w*|<.*>|\*{4,}|x{4,}|'
    r'todo\w*|fixme\w*|redacted\w*|none|null|true|false|1234567890123456)$',
    re.I,
)

# --- gather staged content ----------------------------------------------------
names = subprocess.run(
    ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR'],
    capture_output=True, text=True, check=True,
).stdout.split()

diff = subprocess.run(
    ['git', 'diff', '--cached', '-U0'],
    capture_output=True, text=True, check=True,
).stdout

violations = []

# (a) secret file names
for n in names:
    if ALLOWED_NAME.search(n):
        continue
    if SECRET_NAME.search(n):
        violations.append((n, 'staged file name looks like a secret file'))

# (b) patterns in added lines
added = []  # (file, text)
cur = None
for line in diff.splitlines():
    if line.startswith('+++ b/'):
        cur = line[6:]
        continue
    if line.startswith('+') and cur:
        added.append((cur, line[1:]))

for fname, text in added:
    for pat, label in PATTERNS:
        m = pat.search(text)
        if m:
            violations.append((fname, f'{label}: {mask(m.group(0))}'))
    m = GENERIC.search(text)
    if m:
        name, val = m.group(1), m.group(2)
        if '${' in val:
            continue  # env reference, not a literal
        if PLACEHOLDER.match(val) or len(set(val)) <= 3:
            continue
        if shannon(val) >= 3.5:
            violations.append((fname, f'high-entropy literal assigned to {name}: {mask(val)}'))

# dedupe (keep order)
seen, uniq = set(), []
for v in violations:
    if v not in seen:
        seen.add(v)
        uniq.append(v)

if uniq:
    print('')
    print('pre-commit: SECRETS DETECTED — commit blocked.')
    for f, why in uniq:
        print(f'  - {f}: {why}')
    print('')
    print('  Fix: remove the secret (use a ${VAR} reference or .env, which is gitignored).')
    print('  If a real credential was just staged, ROTATE IT first.')
    print('  Deliberate bypass: git commit --no-verify')
    sys.exit(1)

sys.exit(0)
PYEOF
then
    exit 1
fi

exit 0