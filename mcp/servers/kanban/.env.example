# mcp_kanban configuration — homelab deployment (compose/compose.mcp.yml).
#
# In the homelab the container's env is set in compose.mcp.yml (values
# sourced from the homelab .env), so this file documents the variables and
# their homelab defaults. For local dev outside the homelab, copy to .env.
# All variables: README.md "Configuration" table.

# --- LiteLLM proxy (models + MCP tools) ---------------------------------
# Internal ai-net URL (the container reaches the proxy by service name).
LITELLM_BASE_URL=http://litellm-proxy:4000/v1
# Homelab service key (the global LITELLM_API_KEY in the homelab .env).
# Dual role: (1) outbound LLM calls (groom/task/QA/summary) and (2) the
# "kanban key" — full MCP tool set on /mcp.
LITELLM_API_KEY=sk-...
# Model ID in the LiteLLM config; validated against the proxy at startup (fail fast)
MODEL=matrix-coder

# --- cost estimation (reports) ---------------------------------------------
# No configuration needed: at startup the app fetches the model's cost rates
# from the proxy's /model/info endpoint (the same data the Grafana dashboards
# use) and estimates spend from them. If the endpoint is unavailable or the
# model has no costs configured, tokens are still tracked and reports show
# $0.00. Note: /model/info has no cache-read price, so cache reads estimate
# at $0 (cache-heavy runs slightly under-count spend).

# --- git push auth (deploy stage) ----------------------------------------
# Required for the deploy stage (kind=code/blog/media push). Unset -> the
# app starts with a warning and deploy steps fail until it is provided.
GITHUB_TOKEN=ghp_...

# --- database -------------------------------------------------------------
# sqlite (default, zero external deps) | mysql
DB_DRIVER=sqlite
# SQLite file location (default /data/kanban.db inside the persistent volume)
#SQLITE_PATH=/data/kanban.db
# External MySQL (homelab/Thor): dedicated user, pre-created DB, table-level
# privileges; the app runs migrations (tables only). Required when DB_DRIVER=mysql.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- volumes / workspace ---------------------------------------------------
# Host path mounted read-write at /workspace (compose mount source; informational)
HOST_WORKSPACE_PATH=/home/chuck/workspace
# App-side agent workspace root (task-<id> + groom-<id> dirs). /workspace in the
# container (default); override for local dev.
#AI_KANBAN_WORKSPACE_DIR=/workspace
# Data dir root: SQLite DB, Pi session files, mission briefs, agent dir,
# harness clone. /data inside the container (default; a persistent volume).
#AI_KANBAN_DATA_DIR=/data

# --- agent skills (homelab-ai-harness) -------------------------------------
# Pulled into /data/harness at startup; all sessions get all of its skills
HARNESS_REPO_URL=https://github.com/choukalos/homelab-ai-harness
# Path within the harness repo where skills live
HARNESS_SKILLS_PATH=agents-skills

# --- per-role thinking levels (off|minimal|low|medium|high|xhigh|max) -------
GROOM_THINKING=xhigh
# Grooming turn watchdog: abort a turn with no streaming activity after this
# many minutes. Optional — defaults scale with GROOM_THINKING (off/minimal
# 5, low 10, medium 15, high 20, xhigh/max 30; deep xhigh turns can be
# legitimately quiet 10+ min). Set to override for all levels.
#GROOM_TURN_STALL_MINUTES=15
TASK_THINKING=medium
QA_THINKING=xhigh
SUMMARY_THINKING=medium

# --- orchestrator / server ---------------------------------------------------
# Max tasks running at once
CONCURRENT_TASKS=1
# GUI/API bind (homelab interface only; no auth — LAN-only)
BIND_ADDR=0.0.0.0
PORT=3000

# --- MCP guardrails (multi-user keys) -----------------------------------------
# The kanban key (LITELLM_API_KEY) always gets the full MCP tool set. Other
# LiteLLM keys can be scoped for the /mcp endpoint:
#   key-suffix:cap1,cap2;key-suffix2:cap3   (key-suffix = TAIL of the Bearer
#   key; caps = read / control / admin, or individual tool names)
# Capability sets: read (list_projects, get_project, list_ideas, task_status,
# project_status) ⊂ control (read + add_idea, groom_idea, move_to_backlog,
# start_task, pause_task, resume_task, stop_task, retry_deploy, restart_task)
# ⊂ admin (control + create_project, update_project).
# Keys that match no entry are rejected with a clear error.
#
# Homelab: the caller's LiteLLM key is forwarded by the proxy (extra_headers:
# [Authorization] on the mcp_kanban entry). Map the family keys by suffix:
#   chuck  -> admin   (full control incl. project administration)
#   dylan  -> control (queue/groom/start/stop tasks; no project admin)
# Suffixes are the tails of LITELLM_KEY_CHUCK / LITELLM_KEY_DYLAN in the
# homelab .env — update if either key is rotated.
#MCP_KEY_CAPABILITIES=faxfoUszvw:admin;JAS3o6tu0A:control
