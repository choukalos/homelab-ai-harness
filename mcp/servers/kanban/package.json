{
  "name": "ai-kanban",
  "version": "0.1.0",
  "private": true,
  "description": "Single-container kanban that grooms and executes LLM tasks end-to-end (Pi SDK + LiteLLM proxy).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "mysql2": "^3.15.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
