    {
      "id": 8,
      "title": "Container Overview",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "avg by (name, instance) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "CPU"
        },
        {
          "expr": "avg by (name, instance) (container_memory_usage_bytes{name!=\"\"})",
          "format": "table",
          "instant": true,
          "refId": "MEM"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Container",
              "instance": "Host",
              "Value #CPU": "CPU",
              "Value #MEM": "Memory"
            },
            "indexByName": {
              "Container": 0,
              "Host": 1,
              "CPU": 2,
              "Memory": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "params": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "params": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
