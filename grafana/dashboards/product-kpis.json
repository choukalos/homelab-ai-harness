{
  "uid": "product-kpis-dashboard",
  "title": "Product KPIs",
  "tags": [
    "product",
    "plausible",
    "data-hub"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_MYSQL",
        "type": "datasource",
        "query": "mysql",
        "current": {
          "text": "MySQL",
          "value": "mysql-datahub"
        },
        "hide": 0,
        "regex": null,
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview \u2014 last 7 days",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Pageviews (7d)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT SUM(pageviews) AS value FROM hub.ds_plausible WHERE domain <> 'unknown' AND date >= (CURDATE() - INTERVAL 7 DAY)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": "auto"
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Unique visitors (7d)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT SUM(unique_visitors) AS value FROM hub.ds_plausible WHERE domain <> 'unknown' AND date >= (CURDATE() - INTERVAL 7 DAY)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": "auto"
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Custom events (7d)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT SUM(custom_events) AS value FROM hub.ds_plausible WHERE domain <> 'unknown' AND date >= (CURDATE() - INTERVAL 7 DAY)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": "auto"
        },
        "textMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "Trends & breakdown \u2014 last 30 days",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Pageviews over time (30d)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT date AS time, SUM(pageviews) AS value FROM hub.ds_plausible WHERE domain <> 'unknown' AND date >= (CURDATE() - INTERVAL 30 DAY) GROUP BY date ORDER BY date",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "table",
      "id": 21,
      "title": "By site (30d)",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT domain AS site, SUM(pageviews) AS pageviews, SUM(unique_visitors) AS unique_visitors, SUM(custom_events) AS custom_events FROM hub.ds_plausible WHERE domain <> 'unknown' AND date >= (CURDATE() - INTERVAL 30 DAY) GROUP BY domain ORDER BY pageviews DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": {
          "displayName": "pageviews",
          "desc": true
        }
      }
    }
  ]
}