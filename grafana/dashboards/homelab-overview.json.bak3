    "x": 12,
    "y": 54
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_POWER_USAGE{instance=\"matrix\"}",
     "legendFormat": "{{modelName}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "thresholds": {
      "steps": [
       {
