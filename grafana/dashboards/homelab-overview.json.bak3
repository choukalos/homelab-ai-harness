    "x": 8,
    "y": 54
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_FB_USED{instance=\"matrix\"}",
     "legendFormat": "Used",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes",
     "thresholds": {
      "steps": [
