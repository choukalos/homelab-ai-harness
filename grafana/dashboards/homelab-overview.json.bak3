{
 "id": null,
 "uid": "homelab-overview-dashboard",
 "title": "Homelab Overview",
 "tags": [
  "homelab",
  "overview",
  "monitoring"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 2,
 "refresh": "10s",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "PBFA97CFB590B2093"
    },
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Servers",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "id": 2,
   "title": "Server Status",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum by (instance) (up{job=~\"node-exporter-.*\"})",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "bool",
     "noValue": "OFFLINE",
     "mappings": [
      {
       "options": {
        "1": {
         "text": "UP"
        },
        "0": {
         "text": "DOWN"
        }
       },
       "type": "value"
      }
     ]
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "title": "CPU Usage %",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 5,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 50
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     },
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "title": "Memory Usage %",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 10,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "title": "CPU Usage Over Time",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   },
   "options": {
    "tooltip": {
     "mode": "multi"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "title": "Memory Usage Over Time",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     }
    }
   },
   "options": {
    "tooltip": {
     "mode": "multi"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "title": "AI Usage",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "collapsed": false
  },
  {
   "id": 7,
   "title": "Services",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 27
   },
   "collapsed": false
  },
  {
   "id": 8,
   "title": "Container Overview",
   "type": "table",
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "avg by (name, instance) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
     "format": "table",
     "instant": true,
     "refId": "CPU"
    },
    {
     "expr": "avg by (name, instance) (container_memory_usage_bytes{name!=\"\"})",
     "format": "table",
     "instant": true,
     "refId": "MEM"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "name": "Container",
       "instance": "Host",
       "Value #CPU": "CPU",
       "Value #MEM": "Memory"
      },
      "indexByName": {
       "Container": 0,
       "Host": 1,
       "CPU": 2,
       "Memory": 3
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "params": "CPU"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "params": "Memory"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 26,
   "title": "API Keys",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 40
   },
   "collapsed": false
  },
  {
   "id": 27,
   "title": "Active Keys",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "count(count by (api_key_alias) (litellm_proxy_total_requests_metric_total{api_key_alias!=\"\"})) - 1",
     "legendFormat": "keys",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 29,
   "title": "Total Spend (30d)",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 8,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "sum(increase(litellm_spend_metric_total{api_key_alias!=\"litellm-internal-health-check\"}[30d]))",
     "legendFormat": "total $",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "USD",
     "thresholds": {
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 31,
   "title": "Top Spend Key",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "label_replace(topk(1, sum by (api_key_alias) (increase(litellm_spend_metric_total{api_key_alias!=\"litellm-internal-health-check\"}[30d]))), \"api_key_alias\", \"master\", \"api_key_alias\", \"\")",
     "legendFormat": "{{api_key_alias}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "USD",
     "thresholds": {
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 32,
   "title": "Top 3 Spend by Key (30d)",
   "type": "table",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 46
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "label_replace(sum by (api_key_alias) (increase(litellm_spend_metric_total{api_key_alias!=\"litellm-internal-health-check\"}[30d])), \"api_key_alias\", \"master\", \"api_key_alias\", \"\")",
     "legendFormat": "{{api_key_alias}}",
     "refId": "Spend",
     "instant": true
    },
    {
     "expr": "label_replace(sum by (api_key_alias) (increase(litellm_total_tokens_metric_total{api_key_alias!=\"litellm-internal-health-check\"}[30d])), \"api_key_alias\", \"master\", \"api_key_alias\", \"\")",
     "legendFormat": "{{api_key_alias}}",
     "refId": "Tokens",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "reduce",
     "options": {
      "mode": "reduceRows",
      "reducers": [
       "lastNotNull"
      ]
     }
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "addFieldName": null
     }
    },
    {
     "id": "limit",
     "options": {
      "limit": 3
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Fields": "User",
       "Value #Spend": "Spend (30d)",
       "Value #Tokens": "Tokens (30d)"
      },
      "indexByName": {
       "User": 0,
       "Spend (30d)": 1,
       "Tokens (30d)": 2
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "displayMode": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "params": "User"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "params": "Spend (30d)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "USD"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 17,
   "title": "GPU Metrics",
   "type": "row",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 53
   },
   "collapsed": false
  },
  {
   "id": 18,
   "title": "GPU Utilization %",
   "type": "gauge",
   "gridPos": {
    "h": 7,
    "w": 4,
    "x": 0,
    "y": 54
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_GPU_UTIL{instance=\"matrix\"}",
     "legendFormat": "{{modelName}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 50
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   }
  },
