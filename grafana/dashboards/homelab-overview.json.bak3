  {
   "id": 25,
   "title": "GPU Investment ROI",
   "type": "stat",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 61
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "avg_over_time(DCGM_FI_DEV_GPU_UTIL{instance=\"matrix\"}[1d])",
     "legendFormat": "Avg 24h Utilization",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 30
       },
       {
        "color": "green",
        "value": 70
       }
      ]
     },
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     },
     "displayName": "GPU ROI (24h Avg)"
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 40,
   "title": "Disk Usage %",
   "type": "stat",
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 15,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "100 * (1 - (sum by (instance) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|cifs|rootfs|iso9660|vfat\", device!~\"loop.*\"}) / sum by (instance) (node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|cifs|rootfs|iso9660|vfat\", device!~\"loop.*\"})))",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
