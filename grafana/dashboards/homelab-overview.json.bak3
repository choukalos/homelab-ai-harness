  {
   "id": 22,
   "title": "GPU Utilization Over Time",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 54
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_GPU_UTIL{instance=\"matrix\"}",
     "legendFormat": "{{modelName}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 20
     }
    }
   },
   "options": {
    "tooltip": {
     "mode": "multi"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 23,
   "title": "GPU Temp & Power Over Time",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 61
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_GPU_TEMP{instance=\"matrix\"}",
     "legendFormat": "Temp (\u00b0C)",
     "refId": "A"
    },
    {
     "expr": "DCGM_FI_DEV_POWER_USAGE{instance=\"matrix\"}",
     "legendFormat": "Power (W)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "params": "Temp (\u00b0C)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "celsius"
       },
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     },
     {
