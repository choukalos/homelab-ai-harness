      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, requested_model) (rate(litellm_llm_api_latency_metric_bucket{requested_model!=\"\"}[5m])))",
          "legendFormat": "{{requested_model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 latency by model (5m)",
      "type": "timeseries"
