[Unit]
Description=Daily Plausible analytics export to data-hub (02:00 UTC)

[Timer]
# After the security scans (00:30 host, 01:15 surface). Persistent=true
# catches up a missed run if thor was off at 02:00.
OnCalendar=*-*-* 02:00:00
Persistent=true
RandomizedDelaySec=300
Unit=plausible-export-daily.service

[Install]
WantedBy=timers.target
