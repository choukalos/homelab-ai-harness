[Unit]
Description=Plausible daily analytics export to data-hub (hub.ds_plausible)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=chuck
# Lookback window: 90 days keeps the daily aggregates fresh and bounded.
Environment=INBOX_DIR=/home/chuck/data/finance/inbox
Environment=DAYS=90
ExecStart=/home/chuck/homelab/scripts/plausible-export.sh
# A failed export must not be silent: log to journal, don't mask the timer.
StandardOutput=journal
StandardError=journal
